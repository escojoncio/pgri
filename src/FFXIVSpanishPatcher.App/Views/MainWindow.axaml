<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FFXIVSpanishPatcher.App.ViewModels"
        xmlns:views="using:FFXIVSpanishPatcher.App.Views"
        x:Class="FFXIVSpanishPatcher.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon.ico"
        Title="{Binding WindowTitle}"
        Width="1280"
        Height="800"
        MinWidth="1180"
        MinHeight="740"
        Background="{StaticResource AppBackground}"
        FontFamily="fonts:Inter#Inter">

  <Window.Resources>
    <ResourceDictionary>
    <FontFamily x:Key="Mono">avares://FFXIVSpanishPatcher/Assets/Fonts#JetBrains Mono</FontFamily>

    <SolidColorBrush x:Key="AppBackground" Color="#0F0F12"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#17161A"/>
    <SolidColorBrush x:Key="Surface" Color="#1D1C21"/>
    <SolidColorBrush x:Key="Surface2" Color="#26242B"/>
    <SolidColorBrush x:Key="ConsoleBackground" Color="#09090B"/>
    <SolidColorBrush x:Key="Line" Color="#34323B"/>
    <SolidColorBrush x:Key="LineSoft" Color="#27252D"/>
    <SolidColorBrush x:Key="Text" Color="#F1EEE8"/>
    <SolidColorBrush x:Key="Muted" Color="#A29EA8"/>
    <SolidColorBrush x:Key="Dim" Color="#6F6B77"/>
    <SolidColorBrush x:Key="Accent" Color="#FF8A3D"/>
    <SolidColorBrush x:Key="Mint" Color="#4ADE9A"/>
    <SolidColorBrush x:Key="Amber" Color="#FFC857"/>
    <SolidColorBrush x:Key="Danger" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="Ink" Color="#17161A"/>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="2"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="1.6"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="-0.4"/>
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TextBlock.h3">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="MinHeight" Value="48"/>
      <Setter Property="Padding" Value="20,10"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFA060"/>
      <Setter Property="BorderBrush" Value="#FFA060"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style Selector="Button.primary:disabled">
      <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="48"/>
      <Setter Property="Padding" Value="18,10"/>
    </Style>
    <Style Selector="Button.text">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="Button.text:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.console">
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style Selector="Button.check">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="26"/>
    </Style>
    <Style Selector="FlyoutPresenter">
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Padding" Value="18,22"/>
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="308,*" Background="{StaticResource AppBackground}">

    <!-- ===== Barra lateral: marca, fases, comprobaciones, expansiones, estado ===== -->
    <Border x:Name="SidebarPanel"
            Grid.Column="0"
            Background="{StaticResource SidebarBackground}"
            BorderBrush="{StaticResource Line}"
            BorderThickness="0,0,1,0"
            Padding="20,20,20,16">
      <Grid RowDefinitions="Auto,18,Auto,18,Auto,18,Auto,*,Auto">

        <!-- Marca -->
        <StackPanel Grid.Row="0" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="13">
            <Image Source="/Assets/icon.png" Width="54" Height="54"/>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Classes="mono" Text="FFXIV SPANISH" Foreground="{StaticResource Text}"
                         FontSize="15" FontWeight="Bold" LetterSpacing="0.5"/>
              <TextBlock Classes="mono" Text="PATCHER" Foreground="{StaticResource Accent}"
                         FontSize="15" FontWeight="Bold" LetterSpacing="4"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Padding="8,3" CornerRadius="2" Background="{StaticResource Surface2}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
              <TextBlock Classes="mono" Text="{Binding AppVersionLabel}"
                         Foreground="{StaticResource Text}" FontSize="10.5" FontWeight="SemiBold"/>
            </Border>
            <TextBlock Text="Edición Japonesa"
                       Foreground="{StaticResource Muted}"
                       FontSize="12"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>

        <!-- Fases -->
        <StackPanel Grid.Row="2" Spacing="4">
          <TextBlock Classes="label" Text="FASES"/>
          <Grid ColumnDefinitions="32,*" Height="28">
            <Border Width="22" Height="22" CornerRadius="2" BorderThickness="1"
                    BorderBrush="{StaticResource Line}" HorizontalAlignment="Left">
              <TextBlock Classes="mono" Text="01" Foreground="{StaticResource Dim}" FontSize="10"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Width="22" Height="22" CornerRadius="2" HorizontalAlignment="Left"
                    Background="{StaticResource Accent}" IsVisible="{Binding IsPreparationStage}">
              <TextBlock Classes="mono" Text="01" Foreground="{StaticResource Ink}" FontSize="10" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Width="22" Height="22" CornerRadius="2" HorizontalAlignment="Left"
                    Background="{StaticResource Mint}" IsVisible="{Binding IsPastPreparation}">
              <TextBlock Text="✓" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Grid.Column="1" Text="Preparación" FontSize="13" VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}"/>
            <TextBlock Grid.Column="1" Text="Preparación" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{StaticResource Text}" IsVisible="{Binding IsPreparationStage}"/>
          </Grid>
          <Grid ColumnDefinitions="32,*" Height="28">
            <Border Width="22" Height="22" CornerRadius="2" BorderThickness="1"
                    BorderBrush="{StaticResource Line}" HorizontalAlignment="Left">
              <TextBlock Classes="mono" Text="02" Foreground="{StaticResource Dim}" FontSize="10"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Width="22" Height="22" CornerRadius="2" HorizontalAlignment="Left"
                    Background="{StaticResource Accent}" IsVisible="{Binding IsGeneratingStage}">
              <TextBlock Classes="mono" Text="02" Foreground="{StaticResource Ink}" FontSize="10" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Width="22" Height="22" CornerRadius="2" HorizontalAlignment="Left"
                    Background="{StaticResource Mint}" IsVisible="{Binding IsPastGenerating}">
              <TextBlock Text="✓" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Grid.Column="1" Text="Generando" FontSize="13" VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}"/>
            <TextBlock Grid.Column="1" Text="Generando" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{StaticResource Text}" IsVisible="{Binding IsGeneratingStage}"/>
          </Grid>
          <Grid ColumnDefinitions="32,*" Height="28">
            <Border Width="22" Height="22" CornerRadius="2" BorderThickness="1"
                    BorderBrush="{StaticResource Line}" HorizontalAlignment="Left">
              <TextBlock Classes="mono" Text="03" Foreground="{StaticResource Dim}" FontSize="10"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Width="22" Height="22" CornerRadius="2" HorizontalAlignment="Left"
                    Background="{StaticResource Accent}" IsVisible="{Binding IsResultStage}">
              <TextBlock Classes="mono" Text="03" Foreground="{StaticResource Ink}" FontSize="10" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Grid.Column="1" Text="Resultado" FontSize="13" VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}"/>
            <TextBlock Grid.Column="1" Text="Resultado" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{StaticResource Text}" IsVisible="{Binding IsResultStage}"/>
          </Grid>
        </StackPanel>

        <!-- Comprobaciones previas -->
        <StackPanel Grid.Row="4" Spacing="6">
          <TextBlock Classes="label" Text="COMPROBACIÓN PREVIA"/>

          <Button Classes="check"
                  Command="{Binding BrowseCommand}"
                  ToolTip.Tip="{Binding GamePath}">
            <Grid x:Name="GameCheckContent" ColumnDefinitions="4,36,*" MinHeight="54">
              <Border Background="{StaticResource Mint}" CornerRadius="2,0,0,2"/>
              <TextBlock Grid.Column="1" Text="✓" Foreground="{StaticResource Mint}" FontSize="14"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding GameCheckTitle}" Foreground="{StaticResource Text}"
                           FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding GameCheckSubtitle}" Foreground="{StaticResource Dim}"
                           FontSize="10.5" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Button>

          <Border Classes="row">
            <Grid x:Name="VersionCheckContent" ColumnDefinitions="4,36,*" MinHeight="54">
              <Border Background="{StaticResource Mint}" CornerRadius="2,0,0,2" IsVisible="{Binding IsVersionOk}"/>
              <Border Background="{StaticResource Amber}" CornerRadius="2,0,0,2" IsVisible="{Binding IsVersionWarning}"/>
              <Grid Grid.Column="1">
                <TextBlock Text="✓" Foreground="{StaticResource Mint}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding IsVersionOk}"/>
                <TextBlock Text="!" Foreground="{StaticResource Amber}" FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding IsVersionWarning}"/>
              </Grid>
              <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding VersionCheckTitle}" Foreground="{StaticResource Text}"
                           FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding VersionCheckSubtitle}" Foreground="{StaticResource Dim}"
                           FontSize="10.5" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="row">
            <Grid x:Name="CorpusCheckContent" ColumnDefinitions="4,36,*" MinHeight="54">
              <Border Background="{StaticResource Mint}" CornerRadius="2,0,0,2"/>
              <TextBlock Grid.Column="1" Text="✓" Foreground="{StaticResource Mint}" FontSize="14"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding CorpusCheckTitle}" Foreground="{StaticResource Text}"
                           FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding CorpusCheckSubtitle}" Foreground="{StaticResource Dim}"
                           FontSize="10.5" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>

          <Button Classes="check" Command="{Binding ReviewDalamudCommand}">
            <Grid x:Name="DalamudCheckContent" ColumnDefinitions="4,36,*" MinHeight="54">
              <Border Background="{StaticResource Mint}" CornerRadius="2,0,0,2" IsVisible="{Binding IsDalamudOk}"/>
              <Border Background="{StaticResource Amber}" CornerRadius="2,0,0,2" IsVisible="{Binding IsDalamudWarning}"/>
              <Grid Grid.Column="1">
                <TextBlock Text="✓" Foreground="{StaticResource Mint}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding IsDalamudOk}"/>
                <TextBlock Text="!" Foreground="{StaticResource Amber}" FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding IsDalamudWarning}"/>
              </Grid>
              <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding DalamudCheckTitle}" Foreground="{StaticResource Text}"
                           FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding DalamudCheckSubtitle}" Foreground="{StaticResource Dim}"
                           FontSize="10.5" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Button>
        </StackPanel>

        <!-- Expansiones (orden fijo: ARR, HW, StB, ShB, EW, DT) -->
        <StackPanel Grid.Row="6" Spacing="7">
          <TextBlock Classes="label" Text="EXPANSIONES"/>
          <UniformGrid Columns="6" x:Name="ExpansionStrip" RenderOptions.BitmapInterpolationMode="HighQuality">
            <Image Source="avares://FFXIVSpanishPatcher/Assets/Icons/exp1-meteorito.png" Width="38" Height="38"
                   ToolTip.Tip="A Realm Reborn"/>
            <Image Source="avares://FFXIVSpanishPatcher/Assets/Icons/exp2-dragon-blanco.png" Width="38" Height="38"
                   ToolTip.Tip="Heavensward"/>
            <Image Source="avares://FFXIVSpanishPatcher/Assets/Icons/exp3-katana.png" Width="38" Height="38"
                   ToolTip.Tip="Stormblood"/>
            <Image Source="avares://FFXIVSpanishPatcher/Assets/Icons/exp4-luz-y-sombra.png" Width="38" Height="38"
                   ToolTip.Tip="Shadowbringers"/>
            <Image Source="avares://FFXIVSpanishPatcher/Assets/Icons/exp5-pluma-azul.png" Width="38" Height="38"
                   ToolTip.Tip="Endwalker"/>
            <Image Source="avares://FFXIVSpanishPatcher/Assets/Icons/exp6-ruina-piedra.png" Width="38" Height="38"
                   ToolTip.Tip="Dawntrail"/>
          </UniformGrid>
        </StackPanel>

        <!-- Estado y pie -->
        <StackPanel Grid.Row="8" Spacing="7">
          <Border Height="1" Background="{StaticResource Line}"/>
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="8" Height="8" CornerRadius="1" Background="{StaticResource Accent}"
                    VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource Text}"
                       FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          </Grid>
          <TextBlock Text="{Binding OutputFolder, StringFormat='Salida: {0}'}"
                     Foreground="{StaticResource Dim}" FontSize="10.5"
                     TextTrimming="CharacterEllipsis"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding CorpusFooterLabel, StringFormat='Corpus {0}'}"
                       Foreground="{StaticResource Dim}" FontSize="10.5"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" Classes="text" Content="Aviso legal">
              <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedLeft">
                  <StackPanel Width="440" Spacing="10">
                    <TextBlock Text="Aviso legal" Foreground="{StaticResource Text}"
                               FontWeight="SemiBold" FontSize="15"/>
                    <SelectableTextBlock Text="{Binding LegalNoticeText}"
                                         Foreground="{StaticResource Muted}"
                                         FontSize="13"
                                         TextWrapping="Wrap"
                                         SelectionBrush="{StaticResource Accent}"/>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Zona principal ===== -->
    <Grid Grid.Column="1" Margin="26,22,26,22" RowDefinitions="Auto,18,5*,16,4*">

      <!-- Cabecera: título y acciones -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="4" Margin="0,0,20,0">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Padding="8,3" CornerRadius="2" Background="#26FF8A3D"
                    BorderBrush="#66FF8A3D" BorderThickness="1" IsVisible="{Binding IsVersionOk}">
              <TextBlock Classes="mono" Text="FFXIV compatible" Foreground="{StaticResource Accent}"
                         FontSize="10.5" FontWeight="SemiBold"/>
            </Border>
            <Border Padding="8,3" CornerRadius="2" Background="#26FFC857"
                    BorderBrush="#66FFC857" BorderThickness="1" IsVisible="{Binding IsVersionWarning}">
              <TextBlock Classes="mono" Text="Versión diferente" Foreground="{StaticResource Amber}"
                         FontSize="10.5" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
          <TextBlock Classes="h1" Text="{Binding SetupTitle}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding SetupLead}" Foreground="{StaticResource Muted}" FontSize="13"
                     TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Classes="secondary"
                  Content="Seleccionar translations.dat…"
                  IsVisible="{Binding TranslationsMissing}"
                  Command="{Binding SelectTranslationsFileCommand}"/>
          <Button Classes="secondary"
                  Content="Abrir carpeta de salida"
                  Command="{Binding OpenOutputFolderCommand}"/>
          <Button x:Name="PrimaryAction"
                  Classes="primary"
                  Content="Crear traducción para Penumbra"
                  Command="{Binding GenerateModCommand}"/>
        </StackPanel>
      </Grid>

      <!-- Contenido del mod + estado -->
      <Grid Grid.Row="2" ColumnDefinitions="*,18,300">
        <Border x:Name="ModContentPanel"
                Grid.Column="0"
                Classes="panel"
                ClipToBounds="True"
                Padding="18,14">
          <ScrollViewer x:Name="ModContentScroll"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <TextBlock Classes="label" Text="CONTENIDO DEL MOD"/>
                  <TextBlock Text="Configuración recomendada. Incluye toda traducción aprobada disponible."
                             Foreground="{StaticResource Muted}"
                             FontSize="12"
                             TextWrapping="Wrap"
                             IsVisible="{Binding IsAdvancedClosed}"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="9,4" CornerRadius="2"
                        Background="{StaticResource Surface2}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        VerticalAlignment="Top">
                  <TextBlock Classes="mono" Text="{Binding CategorySummary}"
                             Foreground="{StaticResource Text}" FontSize="10.5"/>
                </Border>
              </Grid>

              <Border IsVisible="{Binding IsVersionWarning}"
                      Padding="12,8"
                      CornerRadius="2"
                      Background="#1FFFC857"
                      BorderBrush="#66FFC857"
                      BorderThickness="1">
                <TextBlock Foreground="{StaticResource Amber}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Text="La instalación usa una versión distinta. Al generar se pedirá confirmación y se aplicará best effort, omitiendo contenido inexistente."/>
              </Border>

              <Button Classes="text"
                      HorizontalAlignment="Left"
                      Command="{Binding ToggleAdvancedCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="[+]" IsVisible="{Binding IsAdvancedClosed}"/>
                  <TextBlock Text="[-]" IsVisible="{Binding IsAdvancedOpen}"/>
                  <TextBlock Text="Opciones avanzadas y categorías"/>
                </StackPanel>
              </Button>

              <StackPanel x:Name="AdvancedPanel"
                          IsVisible="{Binding IsAdvancedOpen}"
                          Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Categorías activadas en primera importación de Penumbra"
                               Foreground="{StaticResource Text}" FontSize="12"/>
                    <TextBlock Text="El paquete siempre incluye traducción completa."
                               Foreground="{StaticResource Dim}" FontSize="10.5"/>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="text" Content="Todas"
                          Command="{Binding SelectAllCategoriesCommand}"/>
                  <Button Grid.Column="2" Classes="text" Content="Ninguna"
                          Command="{Binding SelectNoCategoriesCommand}" Margin="8,0,0,0"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Categories}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryViewModel">
                      <CheckBox IsChecked="{Binding IsSelected}"
                                IsEnabled="{Binding IsEnabled}"
                                ToolTip.Tip="{Binding Tooltip}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="0">
                          <TextBlock Text="{Binding Label}"
                                     TextWrapping="NoWrap"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Classes="mono"
                                     Text="{Binding Count, StringFormat='{}{0:N0}'}"
                                     Foreground="{StaticResource Dim}"
                                     FontSize="10"/>
                        </StackPanel>
                      </CheckBox>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock IsVisible="{Binding ShowCategorySelectionError}"
                           Text="Selecciona al menos una categoría para generar el mod."
                           Foreground="{StaticResource Amber}"
                           FontSize="12"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Classes="panel" Padding="18,14">
          <Grid RowDefinitions="Auto,12,*">
            <TextBlock Classes="label" Text="ESTADO DE GENERACIÓN"/>

            <Grid Grid.Row="2">
              <StackPanel IsVisible="{Binding IsPreparationStage}"
                          VerticalAlignment="Center"
                          Spacing="8">
                <Border Width="44" Height="44" CornerRadius="3"
                        BorderBrush="{StaticResource Mint}" BorderThickness="1"
                        HorizontalAlignment="Left">
                  <TextBlock Text="✓" Foreground="{StaticResource Mint}" FontSize="22"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Classes="h3" Text="Listo para empezar"/>
                <TextBlock Text="La integridad se comprobará siempre al finalizar."
                           Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel IsVisible="{Binding IsGeneratingStage}"
                          VerticalAlignment="Center"
                          Spacing="10">
                <TextBlock Classes="h3" Text="Generando el mod"/>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource Muted}"
                             FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Classes="mono"
                             Text="{Binding ProgressPercent, StringFormat='{}{0} %'}"
                             Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold"/>
                </Grid>
                <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="6"/>
                <UniformGrid Columns="5">
                  <TextBlock Text="Traducc." Foreground="{StaticResource Dim}" FontSize="9.5"/>
                  <TextBlock Text="Extracc." Foreground="{StaticResource Dim}" FontSize="9.5"/>
                  <TextBlock Text="Parche" Foreground="{StaticResource Accent}" FontSize="9.5"/>
                  <TextBlock Text="Carpeta" Foreground="{StaticResource Dim}" FontSize="9.5"/>
                  <TextBlock Text="Integr." Foreground="{StaticResource Dim}" FontSize="9.5"/>
                </UniformGrid>
              </StackPanel>

              <StackPanel IsVisible="{Binding IsResultStage}" Spacing="12" VerticalAlignment="Center">
                <Grid ColumnDefinitions="48,*">
                  <Border Width="38" Height="38" CornerRadius="3" HorizontalAlignment="Left"
                          BorderBrush="{StaticResource Mint}" BorderThickness="1"
                          IsVisible="{Binding IsResultSuccess}">
                    <TextBlock Text="✓" Foreground="{StaticResource Mint}" FontSize="19"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <Border Width="38" Height="38" CornerRadius="3" HorizontalAlignment="Left"
                          BorderBrush="{StaticResource Amber}" BorderThickness="1"
                          IsVisible="{Binding IsResultPartial}">
                    <TextBlock Text="!" Foreground="{StaticResource Amber}" FontSize="19" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <Border Width="38" Height="38" CornerRadius="3" HorizontalAlignment="Left"
                          BorderBrush="{StaticResource Danger}" BorderThickness="1"
                          IsVisible="{Binding IsResultError}">
                    <TextBlock Text="×" Foreground="{StaticResource Danger}" FontSize="21"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="h3" Text="{Binding ResultTitle}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ResultSubtitle}" Foreground="{StaticResource Muted}"
                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Grid>
                <UniformGrid Columns="2" IsVisible="{Binding IsUsableResult}">
                  <StackPanel Margin="0,0,0,8">
                    <TextBlock Classes="mono" Text="{Binding ResultApplied}" Foreground="{StaticResource Text}"
                               FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="Aplicadas" Foreground="{StaticResource Muted}" FontSize="10.5"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,0,8">
                    <TextBlock Classes="mono" Text="{Binding ResultPages}" Foreground="{StaticResource Text}"
                               FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="Páginas" Foreground="{StaticResource Muted}" FontSize="10.5"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Classes="mono" Text="{Binding ResultOmitted}" Foreground="{StaticResource Amber}"
                               FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="Omitidas" Foreground="{StaticResource Muted}" FontSize="10.5"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Classes="mono" Text="{Binding ResultFailures}" Foreground="{StaticResource Mint}"
                               FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="Fallos" Foreground="{StaticResource Muted}" FontSize="10.5"/>
                  </StackPanel>
                </UniformGrid>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- Consola -->
      <Border x:Name="ConsolePanel"
              Grid.Row="4"
              Background="{StaticResource ConsoleBackground}"
              BorderBrush="{StaticResource Line}"
              BorderThickness="1"
              CornerRadius="3"
              ClipToBounds="True"
              Padding="14,10">
        <Grid RowDefinitions="Auto,8,*">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <TextBlock Classes="label" Text="CONSOLA" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Selección continua con ratón, Ctrl+A y Ctrl+C."
                       Foreground="{StaticResource Dim}" FontSize="10.5"
                       VerticalAlignment="Center" Margin="14,0,0,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <Button Classes="console" Content="Seleccionar todo" Click="SelectConsoleAll_OnClick"/>
              <Button Classes="console" Content="Copiar log" Command="{Binding CopyLogCommand}"/>
              <Button Classes="console" Content="Limpiar" Command="{Binding ClearConsoleCommand}"/>
            </StackPanel>
          </Grid>
          <views:ConsoleLogTextBlock Grid.Row="2"
                                     Name="ConsoleText"
                                     Lines="{Binding Console}"
                                     Background="Transparent"
                                     FontFamily="{StaticResource Mono}"
                                     FontSize="12"
                                     WordWrap="False"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"
                                     Foreground="#C9C5CF"/>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== Diálogo modal ===== -->
    <Grid Grid.ColumnSpan="2" Background="#E0060608" IsVisible="{Binding IsModalOpen}">
      <Border Width="600" Classes="panel" Background="{StaticResource SidebarBackground}"
              BorderBrush="{StaticResource Accent}" BorderThickness="1,1,1,1" Padding="26"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="13">
          <Border Width="40" Height="40" CornerRadius="3"
                  BorderBrush="{StaticResource Amber}" BorderThickness="1"
                  HorizontalAlignment="Left">
            <TextBlock Text="!" Foreground="{StaticResource Amber}" FontSize="21" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding ModalTitle}" Classes="h2" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ModalBody}" Foreground="{StaticResource Muted}" FontSize="13.5"
                     TextWrapping="Wrap" LineHeight="20"/>
          <Border Padding="14,11" CornerRadius="2" Background="{StaticResource Surface2}"
                  BorderBrush="{StaticResource Line}" BorderThickness="1">
            <TextBlock Text="{Binding ModalExplanation}" Foreground="{StaticResource Text}"
                       FontSize="13" TextWrapping="Wrap" LineHeight="19"/>
          </Border>
          <TextBlock Text="{Binding ModalNote}" Foreground="{StaticResource Dim}"
                     FontSize="11.5" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="*,10,*" Margin="0,4,0,0">
            <Button Grid.Column="0" Classes="secondary" HorizontalAlignment="Stretch"
                    Content="{Binding ModalSecondaryText}"
                    Command="{Binding DismissModalCommand}"/>
            <Button Grid.Column="2" Classes="primary" HorizontalAlignment="Stretch"
                    Content="{Binding ModalPrimaryText}"
                    Command="{Binding AcceptModalCommand}"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
